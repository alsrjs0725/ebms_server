# EBMS 캐싱 리버스 프록시 공통 설정(http 블록). setup.sh가 /etc/nginx/conf.d/ebms-common.conf로 설치합니다.
# 사이트(release·stage)마다의 설정은 ebms-site.conf.template.

# 곡 zip·차트 청크·사전 청크 캐시. 키는 "경로|내용 sha256"이라 내용이 바뀌면 새로 받고, 옛 항목은 inactive 뒤에 지워집니다.
# release와 stage가 같은 캐시를 나눠 씁니다(같은 sha256이면 같은 내용).
proxy_cache_path /var/cache/nginx/ebms levels=1:2 keys_zone=ebms:64m
                 max_size=${EBMS_CACHE_MAX_SIZE} inactive=${EBMS_CACHE_INACTIVE} use_temp_path=off;

# 접속 IP별 제한(DDoS·남용 완화). 다운로드 본문은 캐시에서 나가므로 요청 수만 막습니다.
limit_req_zone  $binary_remote_addr zone=ebms_api:20m   rate=20r/s;
limit_req_zone  $binary_remote_addr zone=ebms_login:10m rate=30r/m;
limit_req_zone  $binary_remote_addr zone=ebms_dl:20m    rate=10r/s;
limit_conn_zone $binary_remote_addr zone=ebms_conn:20m;
limit_req_status  429;
limit_conn_status 429;

# 느린 연결로 버티는 공격(slowloris) 완화
client_header_timeout 15s;
client_body_timeout   30s;
send_timeout          60s;
keepalive_timeout     30s;
server_tokens off;
