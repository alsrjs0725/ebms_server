# EBMS 캐싱 리버스 프록시 사이트(${EBMS_NAME}). setup.sh가 /etc/nginx/sites-available/ebms-${EBMS_NAME}.conf로 설치합니다.
# 비밀값이 들어 있으므로 root만 읽게 둡니다(chmod 600).
#
# 차트 청크·사전 청크·곡 zip은 요청마다 먼저 오리진의 /api/proxy/authz에 권한을 묻고(로그인·티켓·사용량),
# 통과하면 캐시에서 내보냅니다. 캐시에 없으면 오리진에서 받아 채웁니다. 나머지 요청은 그대로 오리진에 넘깁니다.

upstream ebms_${EBMS_NAME} {
    server ${EBMS_ORIGIN};
    keepalive 16;
}

server {
    listen 80;
    server_name ${EBMS_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # nginx 1.25.1 이상은 "listen 443 ssl;" + "http2 on;"으로 바꿔도 됩니다(경고만 다름).
    listen 443 ssl http2;
    server_name ${EBMS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${EBMS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${EBMS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ebms_ssl:10m;

    limit_conn ebms_conn 32;
    # 곡 임포트 조각(최대 32MB)보다 크게
    client_max_body_size 64m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # 클라이언트가 보낸 X-Forwarded-For는 버리고 실제 접속 IP만 넘깁니다.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    # 클라이언트가 비밀값 헤더를 흉내 내지 못하게 지웁니다(캐시 위치에서만 다시 붙임).
    proxy_set_header X-Ebms-Proxy-Secret "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;

    # 권한 확인(내부 전용). 원래 요청의 Authorization·Cookie·Range·If-None-Match가 그대로 넘어갑니다.
    location = /_ebms_authz {
        internal;
        proxy_pass http://ebms_${EBMS_NAME}/api/proxy/authz;
        proxy_pass_request_body off;
        # location에서 proxy_set_header를 쓰면 server의 것을 물려받지 않으므로 다시 적습니다.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Ebms-Proxy-Secret "${EBMS_PROXY_SECRET}";
        proxy_cache off;
    }

    # 거부: 오리진이 403 + X-Ebms-Status로 알려준 원래 응답을 돌려줍니다.
    location @ebms_denied {
        default_type application/json;
        if ($ebms_status = 401) {
            add_header WWW-Authenticate Bearer always;
            return 401 '{"detail":"$ebms_detail"}';
        }
        if ($ebms_status = 404) {
            return 404 '{"detail":"$ebms_detail"}';
        }
        if ($ebms_status = 429) {
            add_header Retry-After $ebms_retry_after always;
            return 429 '{"detail":"$ebms_detail"}';
        }
        return 403 '{"detail":"forbidden"}';
    }

    # 캐시하는 큰 파일: 차트 청크, 사전 청크, 곡 zip
    location ~ ^/api/(pre/chart|pre/asset|play/song)/[0-9]+$ {
        limit_req zone=ebms_dl burst=200 nodelay;

        auth_request /_ebms_authz;
        auth_request_set $ebms_sha256      $upstream_http_x_ebms_sha256;
        auth_request_set $ebms_limit_rate  $upstream_http_x_ebms_limit_rate;
        auth_request_set $ebms_status      $upstream_http_x_ebms_status;
        auth_request_set $ebms_detail      $upstream_http_x_ebms_detail;
        auth_request_set $ebms_retry_after $upstream_http_x_ebms_retry_after;
        error_page 403 = @ebms_denied;

        # 사전 다운로드 월 한도를 넘은 사용자는 감속(바이트/초, 0이면 제한 없음)
        limit_rate $ebms_limit_rate;

        proxy_cache ebms;
        proxy_cache_key "$uri|$ebms_sha256";
        proxy_cache_valid 200 30d;
        # 같은 파일을 동시에 처음 받으면 오리진에서 한 번만 받습니다.
        proxy_cache_lock on;
        proxy_cache_lock_age 10m;
        proxy_cache_lock_timeout 10m;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Set-Cookie;

        # 캐시 채우기 요청: 사용자 정보 없이 비밀값으로 받습니다(차감은 authz에서 끝남).
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Ebms-Proxy-Secret "${EBMS_PROXY_SECRET}";
        proxy_set_header X-Ebms-Expect-Sha256 $ebms_sha256;

        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://ebms_${EBMS_NAME};
    }

    # 로그인·세션 발급은 더 엄격하게
    location ~ ^/(auth/|login|api/auth/) {
        limit_req zone=ebms_login burst=20 nodelay;
        proxy_pass http://ebms_${EBMS_NAME};
    }

    location / {
        limit_req zone=ebms_api burst=100 nodelay;
        # 사전 파일 하나·매니페스트는 오리진이 사용량을 세고 감속하므로 버퍼 없이 흘려보냅니다.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://ebms_${EBMS_NAME};
    }
}
