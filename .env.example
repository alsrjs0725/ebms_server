# docker compose 설정. `cp .env.example .env` 후 값을 바꿔서 사용하세요.
# 서버는 평문 HTTP로 EBMS_BIND_ADDR:EBMS_PORT(기본 127.0.0.1)에만 열립니다. 외부에는 TLS 리버스 프록시(https)로 공개하세요(docs/deployment.md).
EBMS_PORT=8000
# 프록시가 docker 컨테이너(nginx-proxy-manager 등)라 호스트 루프백에 닿지 못하면 docker 브리지 게이트웨이로 바꿉니다.
# 확인: docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'  (0.0.0.0은 금지)
# EBMS_BIND_ADDR=172.17.0.1
# 프록시 헤더(X-Forwarded-For/Proto)를 믿을 리버스 프록시 주소(쉼표 구분). 컨테이너에서 보면 호스트의 프록시는
# docker 브리지 게이트웨이(예: 172.18.0.1)로 보입니다. 확인: docker network inspect <프로젝트>_default
# EBMS_FORWARDED_ALLOW_IPS=127.0.0.1
# 실행할 서버 이미지. 태그: release(=latest, 정식), <버전>, stage
# EBMS_IMAGE=ghcr.io/alsrjs0725/ebms_server:latest

# 데이터 저장 위치. 절대 경로를 주면 그 폴더에, 비우면 docker 볼륨에 저장합니다.
# 곡·차트가 모두 MySQL에 들어가므로 용량이 큰 디스크(HDD 등)를 권장합니다.
# 예: EBMS_MYSQL_DIR=/mnt/hdd/ebms/release/mysql
EBMS_MYSQL_DIR=
EBMS_VAR_DIR=

MYSQL_DATABASE=ebms
MYSQL_USER=ebms
# 비밀번호에 ' " $ \ 는 쓰지 마세요(MySQL 초기화가 실패하거나 compose가 변수로 해석). 예: openssl rand -hex 16
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 외부에서 접속하는 서버 주소(끝에 / 없이). OAuth 리다이렉트 주소가 <EBMS_PUBLIC_URL>/auth/<oauth>/callback 이 됩니다.
# 공개 서버는 https 주소여야 합니다(세션 쿠키에 Secure가 붙음). localhost가 아닌 http 주소면 시작할 때 경고합니다.
EBMS_PUBLIC_URL=http://localhost:8000
# 쿠키 서명용 임의 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
EBMS_SECRET_KEY=change-me

# 로그인 수단. 비워 두면 로그인 페이지에서 숨깁니다. 등록 방법은 docs/auth.md 참고.
EBMS_GOOGLE_CLIENT_ID=
EBMS_GOOGLE_CLIENT_SECRET=
EBMS_DISCORD_CLIENT_ID=
EBMS_DISCORD_CLIENT_SECRET=

# OAuth가 확인한 이메일이 여기 있으면 로그인할 때 관리자로 지정(쉼표로 구분).
# 승격만 합니다. 목록에서 빼도 강등되지 않으니 관리자 페이지에서 role을 바꾸세요.
EBMS_ADMIN_EMAILS=

# 다운로드 본문(곡 zip·사전 청크) 읽기에 쓰는 스레드 수 한도. API·로그인용 스레드와 따로 세어 큰 곡을 동시에 많이 받아도
# 다른 요청이 밀리지 않게 합니다. 늘리면 MySQL 동시 연결도 늘어납니다.
EBMS_DOWNLOAD_THREADS=16

# S3 호환 스토리지(Cloudflare R2·MinIO·Backblaze B2·AWS S3 등)로 다운로드 내보내기. 비워 두면 지금처럼 서버가 직접 보냅니다.
# 켜면 곡 zip·차트 청크·사전 청크를 버킷에 올리고 presigned URL로 리다이렉트합니다. 원본은 MySQL에 그대로 둡니다(docs/download.md).
# R2 예: EBMS_S3_ENDPOINT=https://<계정 ID>.r2.cloudflarestorage.com, 버킷 범위의 "객체 읽기·쓰기" API 토큰 키
EBMS_S3_ENDPOINT=
EBMS_S3_BUCKET=
EBMS_S3_ACCESS_KEY_ID=
EBMS_S3_SECRET_ACCESS_KEY=
# EBMS_S3_REGION=auto
# 버킷에 둘 최대 바이트. 넘으면 오래 안 받은 곡 zip부터 지웁니다(롤링 캐시). 0이면 지우지 않습니다(전체 저장).
# R2 무료 10GB 안에서 돌리려면 예: 8589934592 (8GB)
EBMS_S3_CACHE_BYTES=0
