# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Keep directory structure in Git while ignoring runtime files
var/log/*
!var/log/.gitkeep

var/media/chart/*
!var/media/chart/.gitkeep

var/media/song/*
!var/media/song/.gitkeep

var/tmp/*
!var/tmp/.gitkeep

var/ebms.db